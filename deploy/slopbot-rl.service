[Unit]
Description=Slopbot Rocket League stats service
After=network-online.target
Wants=network-online.target time-sync.target
After=time-sync.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=slopbot
Group=slopbot
WorkingDirectory=/opt/slopbot
EnvironmentFile=/etc/slopbot.env
ExecStart=/opt/slopbot/bin/slopbot-rl serve
Restart=always
RestartSec=10
TimeoutStopSec=30
UMask=0077
StateDirectory=slopbot
StateDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/slopbot

[Install]
WantedBy=multi-user.target
