# Required: token from Discord Developer Portal -> Bot -> Reset Token
DISCORD_TOKEN=replace-me

# Optional: token from Telegram's @BotFather. Enables Telegram delivery and account linking.
TELEGRAM_BOT_TOKEN=

# SQLite database location. The parent directory is created automatically.
DATABASE_PATH=data/slopbot.db

# Optional Rocket League service. Set both values or leave both blank.
# Keep HTTP on localhost; use a random secret of at least 32 characters.
ROCKET_LEAGUE_SERVICE_URL=
ROCKET_LEAGUE_SERVICE_TOKEN=

# Settings used by the bundled Go service.
RLAPI_LISTEN=127.0.0.1:8765
RLAPI_REFRESH_TOKEN_FILE=/var/lib/slopbot/rlapi-refresh-token

# Optional emergency overrides when Rocket League updates before rlapi does.
# Set both together or leave both blank to use the pinned rlapi defaults.
RLAPI_GAME_VERSION=
RLAPI_FEATURE_SET=

# Optional: sync slash commands to one development server immediately.
# Leave unset in production to register commands globally.
DISCORD_GUILD_ID=

# Optional one-time cleanup for commands previously synced to a guild.
# Remove this setting after one successful startup.
DISCORD_CLEANUP_GUILD_ID=

# Optional PWA push override. The website automatically creates a stable private key
# beside DATABASE_PATH. Set both keys only to reuse an existing VAPID identity.
# The private value may be PEM text or a path readable by Slopbot.
SLOPBOT_VAPID_PRIVATE_KEY=
SLOPBOT_VAPID_PUBLIC_KEY=
SLOPBOT_VAPID_SUBJECT=

# Optional logging level: DEBUG, INFO, WARNING, ERROR, or CRITICAL.
LOG_LEVEL=INFO
