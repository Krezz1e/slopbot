[Unit]
Description=Slopbot Discord voice-channel alerts
After=network-online.target time-sync.target slopbot-rl.service
Wants=network-online.target time-sync.target slopbot-rl.service
StartLimitIntervalSec=0

[Service]
Type=simple
User=slopbot
Group=slopbot
WorkingDirectory=/opt/slopbot
EnvironmentFile=/etc/slopbot.env
ExecStart=/opt/slopbot/.venv/bin/slopbot
Restart=always
RestartSec=10
TimeoutStopSec=30
UMask=0077
StateDirectory=slopbot
StateDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/slopbot

[Install]
WantedBy=multi-user.target
